# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
MODEL=openai/gpt-oss-20b

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional tuning (defaults shown). Bad values stop the gateway at startup with a clear message.
# PROVIDER_ORDER=groq,gemini
# GROQ_TIMEOUT_SECONDS=10
# GEMINI_TIMEOUT_SECONDS=10
# MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_SECONDS=0.5
# RETRY_MAX_DELAY_SECONDS=4
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=30

# Client keys for the gateway itself (comma-separated). Clients send one in the X-API-Key header.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Left empty on purpose: with no keys, every /chat call is rejected (401) until you add your own.
GATEWAY_API_KEYS=

# Rate limiting per client key (defaults shown)
# RATE_LIMIT_ALGORITHM=token_bucket        # or sliding_window
# TOKEN_BUCKET_CAPACITY=10
# TOKEN_BUCKET_REFILL_PER_SECOND=0.2
# SLIDING_WINDOW_LIMIT=12
# SLIDING_WINDOW_SECONDS=60
# REDIS_URL=redis://localhost:6379/0       # empty = limits kept in memory (one instance only)

# Longest prompt accepted, in characters (longer = HTTP 422)
# MAX_PROMPT_CHARS=32000
# Start of each prompt kept for the dashboard's recent-requests table (0 = keep nothing)
# PROMPT_PREVIEW_CHARS=60
# Public deploy: needs GATEWAY_API_KEYS, and PROMPT_PREVIEW_CHARS defaults to 0
# DEPLOY_PUBLIC=false
# Fill an EMPTY request log at startup with made-up fake-provider traffic (no real calls, no cost)
# DEMO_SEED=false
# DEMO_SEED_REQUESTS=150

# Caching (defaults shown). With REDIS_URL set, the exact cache lives in Redis and is shared.
# EXACT_CACHE_ENABLED=true
# CACHE_TTL_SECONDS=3600
# CACHE_MAX_ENTRIES=1000
# CACHE_NODES=redis://localhost:6379/0,redis://localhost:6380/0   # 2+ URLs = exact cache sharded by consistent hashing
# CACHE_VIRTUAL_NODES=100
# DEDUP_ENABLED=true                     # identical in-flight requests share one provider call
# Semantic cache needs: pip install -r requirements-semantic.txt (downloads a ~90 MB model on first run)
# SEMANTIC_CACHE_ENABLED=false
# SEMANTIC_CACHE_THRESHOLD=0.94
# SEMANTIC_GUARD_ENABLED=true
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
